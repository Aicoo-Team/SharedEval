{
  "name": "pact-bench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PACT-Bench: a multi-dataset engine for cross-boundary agent privacy and delegation evaluation.",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "benchmark": "tsx src/runner/v1/cli.ts",
    "build:harbor": "tsc -p tsconfig.harbor.json",
    "generate:golden": "tsx scripts/generate-golden.ts",
    "validate": "tsx src/validate.ts",
    "validate:sample": "tsx src/submission/v1/validate-cli.ts --root . --manifest examples/submissions/typescript-basic/pact.yaml --official",
    "smoke:sample": "tsx src/submission/v1/smoke-sample.ts",
    "smoke:pact-pair": "tsx src/validate.ts --suite pair",
    "eval": "tsx src/suites/pact-pair/evaluation-tools/v1/cli.ts",
    "eval:pact-pair": "tsx src/suites/pact-pair/evaluation-tools/v1/cli.ts",
    "test:evaluation": "tsx --test tests/suites/pact-pair/evaluation-tools/v1/*.test.ts",
    "export:huggingface:pact-pair": "node scripts/huggingface/export-pact-pair.mjs --check",
    "test": "tsx --test tests/protocol-v1/*.test.ts tests/runner-v1/*.test.ts tests/datasets/*.test.ts tests/evaluation/*.test.ts tests/suites/pact-pair/*.test.ts tests/suites/pact-pair/evaluation-tools/v1/*.test.ts",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.13.14",
    "tsx": "^4.20.6",
    "typescript": "^5.8.3"
  }
}
