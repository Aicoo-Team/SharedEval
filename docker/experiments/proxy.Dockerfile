# CONNECT-only forward proxy for one experiment cell. tinyproxy is installed
# at BUILD time so the proxy container needs no network access at startup and
# comes up deterministically; the per-cell config + single-host allowlist are
# generated by scripts/experiments/run-cell.sh and mounted read-only.
FROM alpine:3.22

RUN apk add --no-cache tinyproxy

CMD ["tinyproxy", "-d", "-c", "/etc/sharedeval-proxy/tinyproxy.conf"]
